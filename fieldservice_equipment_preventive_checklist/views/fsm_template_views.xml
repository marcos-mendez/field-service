<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fsm_template_form" model="ir.ui.view">
        <field name="name">fsm.template.form.checklist</field>
        <field name="model">fsm.template</field>
        <field
            name="inherit_id"
            ref="fieldservice_activity.view_fsm_template_form_add_activity"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='temp_activity_ids']/list/field[@name='name']"
                position="after"
            >
                <field name="answer_type" />
            </xpath>
        </field>
    </record>
</odoo>
